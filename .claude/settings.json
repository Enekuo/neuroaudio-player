{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(*git commit*)",
      "Bash(*git push*)"
    ],
    "allow": [
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(npm run:*)"
    ]
  }
}
