rules_version = '2';

// MODO «TODOS» — PRUEBA TEMPORAL. Cualquier usuario con sesión descarga las
// fotos del perfil de los profesionales (nunca sus audios). Va a la vez que
// MOSTRAR_TODOS_LOS_PROFESIONALES = true en
// src/features/perfilProfesional/modoProfesionales.ts. La otra versión está en
// reglas/storage.solo-vinculados.rules (ver reglas/LEEME.md).

service firebase.storage {
  match /b/{bucket}/o {

    // Audios de cada usuario (sin cambios respecto a las reglas que había en
    // la consola de Firebase).
    match /audios/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ¿El usuario con sesión es un oyente con vínculo activo con este
    // profesional? (Una sola lectura de Firestore: si el vínculo no existe,
    // la lectura falla y la regla deniega.)
    function esOyenteVinculado(profesionalUid) {
      let vinculo = firestore.get(/databases/(default)/documents/vinculos/$(profesionalUid + '_' + request.auth.uid)).data;
      return vinculo.oyenteUid == request.auth.uid
        && vinculo.estado == 'activo';
    }

    // ---------- Fotos del perfil del profesional ----------

    // ¿Esta foto es la que el profesional ha reservado (con el límite por
    // minuto de firestore.rules → limitesSubida) en los últimos 5 minutos?
    function esFotoReservada(uid, fotoId) {
      let limite = firestore.get(/databases/(default)/documents/limitesSubida/$(uid)).data;
      return limite.reservada == fotoId
        && request.time < limite.reservadaEn + duration.value(5, 'm');
    }

    // perfiles/{uid}/fotos/{fotoId}/{variante}. Las lee cualquier usuario con
    // sesión; solo las sube o borra el propio profesional. PRUEBA TEMPORAL: en
    // modo «solo vinculados» las leen solo el propio profesional o un oyente
    // con vínculo activo.
    match /perfiles/{uid}/fotos/{fotoId}/{variante} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && variante in ['miniatura', 'normal', 'cuadrada']
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && esFotoReservada(uid, fotoId);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Audios del profesional ----------

    // ¿Este audio es el que el profesional ha reservado (firestore.rules →
    // limitesSubidaAudio) en los últimos 30 minutos? (Margen amplio: un
    // audio grande puede tardar en subir.)
    function esAudioReservado(uid, audioId) {
      let limite = firestore.get(/databases/(default)/documents/limitesSubidaAudio/$(uid)).data;
      return limite.reservada == audioId
        && request.time < limite.reservadaEn + duration.value(30, 'm');
    }

    // ¿Puede escucharlo este oyente? Mira el documento del audio en
    // Firestore: publicado, de este profesional y, si es personal, dirigido
    // a quien lo pide; y además, vínculo activo.
    function puedeEscucharAudio(uid, audioId) {
      let audio = firestore.get(/databases/(default)/documents/audiosProfesional/$(audioId)).data;
      return audio.profesionalUid == uid
        && audio.estado == 'publicado'
        && (audio.tipo == 'general'
            || (audio.tipo == 'personal' && audio.destinatarioUid == request.auth.uid))
        && esOyenteVinculado(uid);
    }

    // audiosPro/{uid}/{audioId}/archivo. Lo lee su dueño o un oyente que
    // puede escucharlo; solo lo sube o borra su dueño: solo audio, 100 MB
    // como mucho (MAX_TAMANO_AUDIO en audiosProfesional/modelo.ts).
    match /audiosPro/{uid}/{audioId}/archivo {
      allow read: if request.auth != null
        && (request.auth.uid == uid || puedeEscucharAudio(uid, audioId));
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|mp4|wav)')
        && esAudioReservado(uid, audioId);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Portada propia de los audios del profesional ----------

    // ¿Puede verla este oyente? Como el archivo del audio: publicado, de este
    // profesional y, si es personal, dirigido a quien la pide; además, esta
    // es su portada actual y hay vínculo activo. Igual en los dos modos.
    function puedeVerPortadaAudio(uid, audioId, imagenId) {
      let audio = firestore.get(/databases/(default)/documents/audiosProfesional/$(audioId)).data;
      return audio.profesionalUid == uid
        && audio.estado == 'publicado'
        && audio.get('portadaImagen', null) == imagenId
        && (audio.tipo == 'general'
            || (audio.tipo == 'personal' && audio.destinatarioUid == request.auth.uid))
        && esOyenteVinculado(uid);
    }

    // audiosPro/{uid}/{audioId}/portadas/{imagenId}. La lee su dueño o quien
    // puede verla; solo la sube o borra su dueño: solo imagen (WebP o JPEG,
    // ya recortada en el navegador), 3 MB como mucho, y reservada con el
    // mismo contador por minuto que las fotos del perfil (limitesSubida).
    match /audiosPro/{uid}/{audioId}/portadas/{imagenId} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || puedeVerPortadaAudio(uid, audioId, imagenId));
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && esFotoReservada(uid, imagenId);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- «Mis audios» (biblioteca del profesional) ----------

    // ¿Puede oír este oyente un audio de la Biblioteca? Las reglas de Storage
    // solo pueden mirar DOS documentos de Firestore por descarga: su vínculo
    // y el audio. Con vínculo activo, el audio es de este profesional y de su
    // Biblioteca, y además:
    // - está publicado en Audios (publicoEnAudios) o en un programa para
    //   todos publicado (enProgramaPublico): cualquier oyente vinculado; o
    // - está en la lista de su vínculo (audiosBiblioteca: sus envíos y sus
    //   programas privados), que solo escribe su profesional.
    // Igual en los dos modos.
    function puedeOirDeBiblioteca(uid, audioId) {
      let vinculo = firestore.get(/databases/(default)/documents/vinculos/$(uid + '_' + request.auth.uid)).data;
      let audio = firestore.get(/databases/(default)/documents/audiosProfesional/$(audioId)).data;
      return vinculo.oyenteUid == request.auth.uid
        && vinculo.estado == 'activo'
        && audio.profesionalUid == uid
        && audio.tipo == 'biblioteca'
        && (audio.get('publicoEnAudios', false) == true
            || audio.get('enProgramaPublico', false) == true
            || audioId in vinculo.get('audiosBiblioteca', []));
    }

    // Transición: los envíos de antes de audiosBiblioteca. Mira el envío y el
    // vínculo (dos documentos); se deja al final por si aún no está en la
    // lista de su vínculo.
    function tieneEnvio(uid, audioId) {
      let envio = firestore.get(/databases/(default)/documents/enviosAudio/$(audioId + '__' + request.auth.uid)).data;
      return envio.profesionalUid == uid;
    }

    // bibliotecaPro/{uid}/{audioId}/archivo. Lo lee su dueño o quien puede
    // oírlo; solo lo sube o borra su dueño, como los demás audios: solo
    // audio, 100 MB como mucho y reservado.
    match /bibliotecaPro/{uid}/{audioId}/archivo {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || puedeOirDeBiblioteca(uid, audioId)
            || (tieneEnvio(uid, audioId) && esOyenteVinculado(uid)));
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|mp4|wav)')
        && esAudioReservado(uid, audioId);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // bibliotecaPro/{uid}/{audioId}/portadas/{imagenId}: su portada propia.
    // La ve quien puede oír el audio, y solo la que usa ahora; la sube o
    // borra solo su dueño: solo imagen, 3 MB como mucho y reservada
    // (limitesSubida).
    match /bibliotecaPro/{uid}/{audioId}/portadas/{imagenId} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || (puedeOirDeBiblioteca(uid, audioId)
                && firestore.get(/databases/(default)/documents/audiosProfesional/$(audioId)).data.get('portadaImagen', null) == imagenId)
            || (tieneEnvio(uid, audioId) && esOyenteVinculado(uid)));
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && esFotoReservada(uid, imagenId);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Imagen propia de las listas del profesional ----------

    // ¿Puede verla este oyente? La lista está publicada, es de este
    // profesional, esta es su imagen actual y hay vínculo activo. Igual en
    // los dos modos («todos» y «solo vinculados»).
    function puedeVerImagenLista(uid, listaId, imagenId) {
      let lista = firestore.get(/databases/(default)/documents/listasProfesional/$(listaId)).data;
      return lista.profesionalUid == uid
        && lista.estado == 'publicado'
        && lista.imagen == imagenId
        && esOyenteVinculado(uid);
    }

    // listasPro/{uid}/{listaId}/{imagenId}. La lee su dueño o un oyente que
    // puede verla; solo la sube o borra su dueño, en sus listas propias:
    // solo imagen (WebP o JPEG, ya recortada en el navegador), 3 MB como
    // mucho, y reservada con el mismo contador por minuto que las fotos del
    // perfil (firestore.rules → limitesSubida).
    match /listasPro/{uid}/{listaId}/{imagenId} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || puedeVerImagenLista(uid, listaId, imagenId));
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && listaId.matches(uid + '__propia__([1-9]|[12][0-9]|30)')
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && esFotoReservada(uid, imagenId);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
